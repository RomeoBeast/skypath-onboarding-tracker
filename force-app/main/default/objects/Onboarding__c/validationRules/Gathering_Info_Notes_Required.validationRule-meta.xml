<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gathering_Info_Notes_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Stage__c), TEXT(PRIORVALUE(Stage__c)) = &quot;Gathering Info&quot;, ISBLANK(Gathering_Info_Notes__c))</errorConditionFormula>
    <errorMessage>Add Gathering Info Notes before moving on.</errorMessage>
</ValidationRule>
