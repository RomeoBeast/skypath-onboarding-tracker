<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Implementation_Notes_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Stage__c), TEXT(PRIORVALUE(Stage__c)) = &quot;Implementation&quot;, ISBLANK(Implementation_Notes__c))</errorConditionFormula>
    <errorMessage>Add Implementation Notes before moving on.</errorMessage>
</ValidationRule>
